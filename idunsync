#!/bin/bash

set -euo pipefail

REPO_DIR=$(cd "$(dirname "$0")" && pwd)
IDUN_USER=${IDUN_USER:-$USER}
IDUN_HOST=${IDUN_HOST:-idun-login1.hpc.ntnu.no}
IDUN_DIR=${IDUN_DIR:-wcsph_dambreak}

rsync -av --progress \
    --exclude='.git/' \
    --exclude='/idunsync' \
    --exclude='/idunget' \
    --exclude='/wcsph_dambreak' \
    --exclude='data/' \
    --exclude='images/' \
    --exclude='runs/' \
    --exclude='slurm-*.out' \
    --exclude='slurm-*.err' \
    "$REPO_DIR/" \
    "$IDUN_USER@$IDUN_HOST:$IDUN_DIR/"
